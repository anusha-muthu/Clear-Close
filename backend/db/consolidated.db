
-- ============================================================
-- CLEAR CLOSE - COMPLETE ORACLE DATABASE SCHEMA
-- Total Tables: 14
-- Run using F5 (Run Script) in Oracle SQL Developer.
-- Intended for a schema where these tables do not yet exist.
-- ============================================================


-- ============================================================
-- 1. BORROWERS
-- Customer login and account details
-- ============================================================

CREATE TABLE BORROWERS (
    USER_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    NAME VARCHAR2(150) NOT NULL,
    USERNAME VARCHAR2(100) NOT NULL UNIQUE,
    PASSWORD_HASH VARCHAR2(255) NOT NULL,
    EMAIL VARCHAR2(150) NOT NULL UNIQUE,
    PHONE VARCHAR2(20),
    PAN_CARD VARCHAR2(10) NOT NULL UNIQUE,
    LOCATION VARCHAR2(150),
    ACCOUNT_STATUS VARCHAR2(20) DEFAULT 'ACTIVE' NOT NULL,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT CHK_BORROWER_STATUS CHECK (
        ACCOUNT_STATUS IN ('ACTIVE', 'LOCKED', 'DISABLED')
    ),

    CONSTRAINT CHK_BORROWER_PAN CHECK (
        REGEXP_LIKE(PAN_CARD, '^[A-Z]{5}[0-9]{4}[A-Z]$')
    )
);


-- ============================================================
-- 2. OFFICER
-- Separate employee login with different officer roles
-- ============================================================

CREATE TABLE OFFICER (
    OFFICER_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    USER_ID NUMBER,
    FULL_NAME VARCHAR2(150) NOT NULL,
    USERNAME VARCHAR2(100) NOT NULL UNIQUE,
    PASSWORD_HASH VARCHAR2(255) NOT NULL,
    EMAIL VARCHAR2(150) NOT NULL UNIQUE,
    PAN_CARD VARCHAR2(10) UNIQUE,
    ROLE VARCHAR2(30) NOT NULL,
    LOCATION VARCHAR2(150),
    ACCOUNT_STATUS VARCHAR2(20) DEFAULT 'ACTIVE' NOT NULL,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_OFFICER_USER
        FOREIGN KEY (USER_ID)
        REFERENCES BORROWERS(USER_ID),

    CONSTRAINT UQ_OFFICER_USER UNIQUE (USER_ID),

    CONSTRAINT CHK_OFFICER_ROLE CHECK (
        ROLE IN (
            'LOAN_CLOSURE_OFFICER',
            'GRIEVANCE_OFFICER',
            'COLLATERAL_OFFICER',
            'ADMIN'
        )
    ),

    CONSTRAINT CHK_OFFICER_STATUS CHECK (
        ACCOUNT_STATUS IN ('ACTIVE', 'LOCKED', 'DISABLED')
    ),

    CONSTRAINT CHK_OFFICER_PAN CHECK (
        PAN_CARD IS NULL
        OR REGEXP_LIKE(PAN_CARD, '^[A-Z]{5}[0-9]{4}[A-Z]$')
    )
);


-- ============================================================
-- 3. LOAN_PRODUCT_RULE
-- Rules for cooling-off, foreclosure and closure
-- ============================================================

CREATE TABLE LOAN_PRODUCT_RULE (
    RULE_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    PRODUCT_TYPE VARCHAR2(50) NOT NULL,
    COOLING_OFF_DAYS NUMBER(4) DEFAULT 0 NOT NULL,
    COOLING_OFF_PROCESSING_FEE NUMBER(12,2) DEFAULT 0 NOT NULL,
    EARLY_CLOSURE_ALLOWED CHAR(1) DEFAULT 'Y' NOT NULL,
    CLOSURE_CHARGE_TYPE VARCHAR2(20) DEFAULT 'NONE' NOT NULL,
    CLOSURE_CHARGE_VALUE NUMBER(12,2) DEFAULT 0 NOT NULL,
    NOC_REQUIRES_FULL_SETTLEMENT CHAR(1) DEFAULT 'Y' NOT NULL,
    COLLATERAL_RELEASE_REQUIRES_CLOSURE CHAR(1) DEFAULT 'Y' NOT NULL,
    EFFECTIVE_FROM DATE DEFAULT SYSDATE NOT NULL,
    EFFECTIVE_TO DATE,
    RULE_STATUS VARCHAR2(20) DEFAULT 'ACTIVE' NOT NULL,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT UQ_RULE_PRODUCT_START
        UNIQUE (PRODUCT_TYPE, EFFECTIVE_FROM),

    CONSTRAINT CHK_COOLING_DAYS
        CHECK (COOLING_OFF_DAYS >= 0),

    CONSTRAINT CHK_CO_PROCESSING_FEE
        CHECK (COOLING_OFF_PROCESSING_FEE >= 0),

    CONSTRAINT CHK_EARLY_CLOSURE
        CHECK (EARLY_CLOSURE_ALLOWED IN ('Y', 'N')),

    CONSTRAINT CHK_CLOSURE_CHARGE_TYPE
        CHECK (CLOSURE_CHARGE_TYPE IN (
            'NONE', 'FIXED', 'PERCENTAGE'
        )),

    CONSTRAINT CHK_CLOSURE_CHARGE_VALUE
        CHECK (CLOSURE_CHARGE_VALUE >= 0),

    CONSTRAINT CHK_NOC_SETTLEMENT
        CHECK (NOC_REQUIRES_FULL_SETTLEMENT IN ('Y', 'N')),

    CONSTRAINT CHK_COLLATERAL_CLOSURE
        CHECK (COLLATERAL_RELEASE_REQUIRES_CLOSURE IN ('Y', 'N')),

    CONSTRAINT CHK_RULE_DATES
        CHECK (
            EFFECTIVE_TO IS NULL
            OR EFFECTIVE_TO >= EFFECTIVE_FROM
        ),

    CONSTRAINT CHK_RULE_STATUS
        CHECK (RULE_STATUS IN ('ACTIVE', 'INACTIVE'))
);


-- ============================================================
-- 4. LOAN_ACCOUNT
-- Existing loans belonging to borrowers
-- ============================================================

CREATE TABLE LOAN_ACCOUNT (
    LOAN_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    BORROWER_ID NUMBER NOT NULL,
    RULE_ID NUMBER NOT NULL,
    LOAN_REFERENCE VARCHAR2(50) NOT NULL UNIQUE,
    PRINCIPAL_AMOUNT NUMBER(15,2) NOT NULL,
    OUTSTANDING_AMOUNT NUMBER(15,2) NOT NULL,
    INTEREST_RATE NUMBER(7,4) NOT NULL,
    TENURE_MONTHS NUMBER(4) NOT NULL,
    DISBURSEMENT_DATE DATE,
    MATURITY_DATE DATE,
    LOAN_STATUS VARCHAR2(30) DEFAULT 'ACTIVE' NOT NULL,
    CLOSURE_DATE DATE,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_LOAN_BORROWER
        FOREIGN KEY (BORROWER_ID)
        REFERENCES BORROWERS(USER_ID),

    CONSTRAINT FK_LOAN_RULE
        FOREIGN KEY (RULE_ID)
        REFERENCES LOAN_PRODUCT_RULE(RULE_ID),

    CONSTRAINT CHK_LOAN_PRINCIPAL
        CHECK (PRINCIPAL_AMOUNT > 0),

    CONSTRAINT CHK_LOAN_OUTSTANDING
        CHECK (OUTSTANDING_AMOUNT >= 0),

    CONSTRAINT CHK_LOAN_INTEREST
        CHECK (INTEREST_RATE >= 0),

    CONSTRAINT CHK_LOAN_TENURE
        CHECK (TENURE_MONTHS > 0),

    CONSTRAINT CHK_LOAN_STATUS
        CHECK (
            LOAN_STATUS IN (
                'PENDING', 'ACTIVE', 'CLOSED',
                'DEFAULTED', 'CANCELLED', 'EXIT_COMPLETED'
            )
        )
);


-- ============================================================
-- 5. COOLING_OFF_REQUEST
-- Borrower requests to exit during the cooling-off period
-- ============================================================

CREATE TABLE COOLING_OFF_REQUEST (
    EXIT_REQUEST_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    LOAN_ID NUMBER NOT NULL,
    OFFICER_ID NUMBER,
    REQUEST_DATE DATE DEFAULT SYSDATE NOT NULL,
    EXPIRY_DATE DATE,
    STATUS VARCHAR2(30) DEFAULT 'PENDING' NOT NULL,
    REASON VARCHAR2(1000),
    DECIDED_AT TIMESTAMP,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_COOLING_LOAN
        FOREIGN KEY (LOAN_ID)
        REFERENCES LOAN_ACCOUNT(LOAN_ID),

    CONSTRAINT FK_COOLING_OFFICER
        FOREIGN KEY (OFFICER_ID)
        REFERENCES OFFICER(OFFICER_ID),

    CONSTRAINT CHK_COOLING_STATUS CHECK (
        STATUS IN (
            'PENDING',
            'UNDER_REVIEW',
            'MORE_INFO_REQUIRED',
            'APPROVED',
            'REJECTED',
            'CANCELLED',
            'EXPIRED',
            'COMPLETED'
        )
    )
);


-- ============================================================
-- 6. LOAN_CLOSURE_REQUEST
-- Normal loan closure and early foreclosure
-- ============================================================

CREATE TABLE LOAN_CLOSURE_REQUEST (
    CLOSURE_REQUEST_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    LOAN_ID NUMBER NOT NULL,
    OFFICER_ID NUMBER,
    REQUEST_DATE DATE DEFAULT SYSDATE NOT NULL,
    CLOSURE_TYPE VARCHAR2(30) NOT NULL,
    STATUS VARCHAR2(30) DEFAULT 'PENDING' NOT NULL,
    REASON VARCHAR2(1000),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_CLOSURE_LOAN
        FOREIGN KEY (LOAN_ID)
        REFERENCES LOAN_ACCOUNT(LOAN_ID),

    CONSTRAINT FK_CLOSURE_OFFICER
        FOREIGN KEY (OFFICER_ID)
        REFERENCES OFFICER(OFFICER_ID),

    CONSTRAINT CHK_CLOSURE_TYPE CHECK (
        CLOSURE_TYPE IN (
            'NORMAL', 'FORECLOSURE', 'PREPAYMENT'
        )
    ),

    CONSTRAINT CHK_CLOSURE_STATUS CHECK (
        STATUS IN (
            'PENDING',
            'UNDER_REVIEW',
            'APPROVED',
            'REJECTED',
            'PAYMENT_PENDING',
            'COMPLETED',
            'CANCELLED'
        )
    )
);


-- ============================================================
-- 7. SETTLEMENT_QUOTE
-- Shared by Cooling-Off and Normal Loan Closure
-- ============================================================

CREATE TABLE SETTLEMENT_QUOTE (
    QUOTE_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    LOAN_ID NUMBER NOT NULL,
    EXIT_REQUEST_ID NUMBER,
    CLOSURE_REQUEST_ID NUMBER,
    QUOTE_TYPE VARCHAR2(30) NOT NULL,
    PRINCIPAL_AMOUNT NUMBER(15,2) NOT NULL,
    INTEREST_AMOUNT NUMBER(15,2) DEFAULT 0 NOT NULL,
    CHARGES_AMOUNT NUMBER(15,2) DEFAULT 0 NOT NULL,
    TAX_AMOUNT NUMBER(15,2) DEFAULT 0 NOT NULL,
    TOTAL_AMOUNT NUMBER(15,2) NOT NULL,
    VALID_UNTIL DATE NOT NULL,
    QUOTE_STATUS VARCHAR2(30) DEFAULT 'AVAILABLE' NOT NULL,
    ACCEPTED_AT TIMESTAMP,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_QUOTE_LOAN
        FOREIGN KEY (LOAN_ID)
        REFERENCES LOAN_ACCOUNT(LOAN_ID),

    CONSTRAINT FK_QUOTE_EXIT
        FOREIGN KEY (EXIT_REQUEST_ID)
        REFERENCES COOLING_OFF_REQUEST(EXIT_REQUEST_ID),

    CONSTRAINT FK_QUOTE_CLOSURE
        FOREIGN KEY (CLOSURE_REQUEST_ID)
        REFERENCES LOAN_CLOSURE_REQUEST(CLOSURE_REQUEST_ID),

    CONSTRAINT CHK_QUOTE_TYPE CHECK (
        QUOTE_TYPE IN ('COOLING_OFF', 'CLOSURE')
    ),

    CONSTRAINT CHK_QUOTE_REQUEST CHECK (
        (
            QUOTE_TYPE = 'COOLING_OFF'
            AND EXIT_REQUEST_ID IS NOT NULL
            AND CLOSURE_REQUEST_ID IS NULL
        )
        OR
        (
            QUOTE_TYPE = 'CLOSURE'
            AND CLOSURE_REQUEST_ID IS NOT NULL
            AND EXIT_REQUEST_ID IS NULL
        )
    ),

    CONSTRAINT CHK_QUOTE_STATUS CHECK (
        QUOTE_STATUS IN (
            'AVAILABLE', 'ACCEPTED', 'EXPIRED', 'PAID'
        )
    ),

    CONSTRAINT CHK_QUOTE_AMOUNT CHECK (
        PRINCIPAL_AMOUNT >= 0
        AND INTEREST_AMOUNT >= 0
        AND CHARGES_AMOUNT >= 0
        AND TAX_AMOUNT >= 0
        AND TOTAL_AMOUNT =
            PRINCIPAL_AMOUNT + INTEREST_AMOUNT
            + CHARGES_AMOUNT + TAX_AMOUNT
    )
);


-- ============================================================
-- 8. PAYMENT
-- Razorpay Test Mode payment details
-- ============================================================

CREATE TABLE PAYMENT (
    PAYMENT_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    QUOTE_ID NUMBER NOT NULL,
    RAZORPAY_ORDER_ID VARCHAR2(100),
    RAZORPAY_PAYMENT_ID VARCHAR2(100) UNIQUE,
    AMOUNT NUMBER(15,2) NOT NULL,
    PAYMENT_STATUS VARCHAR2(30) DEFAULT 'PENDING' NOT NULL,
    PAYMENT_DATE DATE,
    METHOD VARCHAR2(30),
    CONFIRMED_AT TIMESTAMP,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_PAYMENT_QUOTE
        FOREIGN KEY (QUOTE_ID)
        REFERENCES SETTLEMENT_QUOTE(QUOTE_ID),

    CONSTRAINT CHK_PAYMENT_STATUS CHECK (
        PAYMENT_STATUS IN (
            'PENDING',
            'INITIATED',
            'SUCCESS',
            'FAILED',
            'REFUNDED',
            'CANCELLED'
        )
    ),

    CONSTRAINT CHK_PAYMENT_METHOD CHECK (
        METHOD IN (
            'UPI',
            'NET_BANKING',
            'DEBIT_CARD',
            'CREDIT_CARD',
            'NEFT',
            'RTGS',
            'IMPS'
        )
    ),

    CONSTRAINT CHK_PAYMENT_AMOUNT
        CHECK (AMOUNT > 0)
);


-- ============================================================
-- 9. NOC
-- No Objection Certificate issued after loan closure
-- ============================================================

CREATE TABLE NOC (
    NOC_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    LOAN_ID NUMBER NOT NULL,
    CERTIFICATE_NUMBER VARCHAR2(100) UNIQUE NOT NULL,
    ISSUE_DATE DATE DEFAULT SYSDATE NOT NULL,
    FILE_PATH VARCHAR2(500),
    FILE_HASH VARCHAR2(64),
    NOC_STATUS VARCHAR2(30) DEFAULT 'GENERATION_PENDING' NOT NULL,
    VERSION_NUMBER NUMBER(10) DEFAULT 1 NOT NULL,
    GENERATED_AT TIMESTAMP,
    ISSUED_BY NUMBER(19),
    REMARKS VARCHAR2(1000),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_NOC_LOAN
        FOREIGN KEY (LOAN_ID)
        REFERENCES LOAN_ACCOUNT(LOAN_ID)
);

CREATE TABLE NOC_AUDIT (
    AUDIT_ID NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    NOC_ID NUMBER(19) NOT NULL,
    ACTION VARCHAR2(100) NOT NULL,
    ACTOR_ID NUMBER(19),
    ACTION_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    REMARKS VARCHAR2(1000),
    CONSTRAINT FK_NOC_AUDIT_NOC FOREIGN KEY (NOC_ID) REFERENCES NOC(NOC_ID)
);

CREATE INDEX IX_NOC_AUDIT_NOC_TIME ON NOC_AUDIT (NOC_ID, ACTION_AT);


-- ============================================================
-- 10. GRIEVANCES
-- Borrower complaint ticket management
-- ============================================================

CREATE TABLE GRIEVANCES (
    GRIEVANCE_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    LOAN_ACCOUNT_ID NUMBER NOT NULL,
    BORROWER_ID NUMBER NOT NULL,
    CATEGORY VARCHAR2(30) NOT NULL,
    DESCRIPTION VARCHAR2(1000) NOT NULL,
    STATUS VARCHAR2(30) DEFAULT 'OPEN' NOT NULL,
    ASSIGNED_TO NUMBER,
    RESOLUTION_REMARKS VARCHAR2(1000),
    EXPECTED_RESOLUTION_AT TIMESTAMP,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_GRIEVANCES_LOAN
        FOREIGN KEY (LOAN_ACCOUNT_ID)
        REFERENCES LOAN_ACCOUNT(LOAN_ID),

    CONSTRAINT FK_GRIEVANCES_BORROWER
        FOREIGN KEY (BORROWER_ID)
        REFERENCES BORROWERS(USER_ID),

    CONSTRAINT FK_GRIEVANCES_OFFICER
        FOREIGN KEY (ASSIGNED_TO)
        REFERENCES OFFICER(OFFICER_ID),

    CONSTRAINT CHK_GRIEVANCES_STATUS CHECK (
        STATUS IN (
            'OPEN',
            'IN_PROGRESS',
            'MORE_INFO_REQUIRED',
            'RESOLVED',
            'REJECTED',
            'ESCALATED',
            'CLOSED'
        )
    )
);


-- ============================================================
-- 11. GRIEVANCES_HISTORY
-- Status changes and comments on grievance tickets
-- ============================================================

CREATE TABLE GRIEVANCES_HISTORY (
    HISTORY_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    GRIEVANCE_ID NUMBER NOT NULL,
    OLD_STATUS VARCHAR2(30),
    NEW_STATUS VARCHAR2(30) NOT NULL,
    ACTION_REMARKS VARCHAR2(1000) NOT NULL,
    ACTION_BY NUMBER,
    ACTOR_TYPE VARCHAR2(20) NOT NULL,
    ACTION_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_GRIEVANCES_HISTORY
        FOREIGN KEY (GRIEVANCE_ID)
        REFERENCES GRIEVANCES(GRIEVANCE_ID),

    CONSTRAINT CHK_GRIEVANCES_HISTORY_STATUS CHECK (
        NEW_STATUS IN (
            'OPEN',
            'IN_PROGRESS',
            'MORE_INFO_REQUIRED',
            'RESOLVED',
            'REJECTED',
            'ESCALATED',
            'CLOSED'
        )
    ),

    CONSTRAINT CHK_GRIEVANCES_HISTORY_ACTOR CHECK (
        (
            ACTOR_TYPE IN ('BORROWER', 'OFFICER')
            AND ACTION_BY IS NOT NULL
        )
        OR
        (
            ACTOR_TYPE = 'SYSTEM'
            AND ACTION_BY IS NULL
        )
    )
);


-- ============================================================
-- 12. COLLATERAL
-- Collateral assets associated with secured loans
-- ============================================================

CREATE TABLE COLLATERAL (
    COLLATERAL_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    LOAN_ACCOUNT_ID NUMBER NOT NULL,
    COLLATERAL_TYPE VARCHAR2(30) NOT NULL,
    DESCRIPTION VARCHAR2(500),
    CUSTODIAN VARCHAR2(100),
    RELEASE_STATUS VARCHAR2(30) DEFAULT 'NOT_ELIGIBLE' NOT NULL,
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_COLLATERAL_LOAN
        FOREIGN KEY (LOAN_ACCOUNT_ID)
        REFERENCES LOAN_ACCOUNT(LOAN_ID),

    CONSTRAINT CHK_COLLATERAL_STATUS CHECK (
        RELEASE_STATUS IN (
            'NOT_ELIGIBLE',
            'ELIGIBLE',
            'RELEASE_PENDING',
            'RELEASED'
        )
    )
);


-- ============================================================
-- 13. COLLATERAL_RELEASE_REQUESTS
-- Tracks collateral and hypothecation release
-- ============================================================

CREATE TABLE COLLATERAL_RELEASE_REQUESTS (
    REQUEST_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    COLLATERAL_ID NUMBER NOT NULL,
    LOAN_ACCOUNT_ID NUMBER NOT NULL,
    REQUESTED_BY NUMBER NOT NULL,
    ASSIGNED_TO NUMBER,
    STATUS VARCHAR2(30) DEFAULT 'PENDING' NOT NULL,
    REASON VARCHAR2(1000),
    EXPECTED_RELEASE_DATE DATE,
    RELEASED_AT TIMESTAMP,
    RELEASE_REFERENCE VARCHAR2(100),
    CREATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    UPDATED_AT TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,

    CONSTRAINT FK_RELEASE_COLLATERAL
        FOREIGN KEY (COLLATERAL_ID)
        REFERENCES COLLATERAL(COLLATERAL_ID),

    CONSTRAINT FK_RELEASE_LOAN
        FOREIGN KEY (LOAN_ACCOUNT_ID)
        REFERENCES LOAN_ACCOUNT(LOAN_ID),

    CONSTRAINT FK_RELEASE_REQUESTED_BY
        FOREIGN KEY (REQUESTED_BY)
        REFERENCES BORROWERS(USER_ID),

    CONSTRAINT FK_RELEASE_ASSIGNED_TO
        FOREIGN KEY (ASSIGNED_TO)
        REFERENCES OFFICER(OFFICER_ID),

    CONSTRAINT CHK_RELEASE_STATUS CHECK (
        STATUS IN (
            'PENDING',
            'UNDER_REVIEW',
            'INFO_REQUIRED',
            'APPROVED',
            'RELEASE_IN_PROGRESS',
            'RELEASE_DELAYED',
            'REJECTED',
            'RELEASED'
        )
    )
);


-- ============================================================
-- 14. AUDIT_LOG
-- Records actions throughout all Clear Close modules
-- ============================================================

CREATE TABLE AUDIT_LOG (
    LOG_ID NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    USER_ID NUMBER,
    OFFICER_ID NUMBER,
    ENTITY_ID NUMBER NOT NULL,
    ENTITY_TYPE VARCHAR2(50) NOT NULL,
    ACTION VARCHAR2(100) NOT NULL,
    ACTION_TIME TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
    DETAILS VARCHAR2(1000),

    PAYMENT_ID NUMBER,
    QUOTE_ID NUMBER,
    EXIT_REQUEST_ID NUMBER,
    CLOSURE_REQUEST_ID NUMBER,
    NOC_ID NUMBER,
    GRIEVANCE_ID NUMBER,
    RELEASE_REQUEST_ID NUMBER,

    CONSTRAINT FK_AUDIT_USER
        FOREIGN KEY (USER_ID)
        REFERENCES BORROWERS(USER_ID),

    CONSTRAINT FK_AUDIT_OFFICER
        FOREIGN KEY (OFFICER_ID)
        REFERENCES OFFICER(OFFICER_ID),

    CONSTRAINT FK_AUDIT_PAYMENT
        FOREIGN KEY (PAYMENT_ID)
        REFERENCES PAYMENT(PAYMENT_ID),

    CONSTRAINT FK_AUDIT_QUOTE
        FOREIGN KEY (QUOTE_ID)
        REFERENCES SETTLEMENT_QUOTE(QUOTE_ID),

    CONSTRAINT FK_AUDIT_EXIT
        FOREIGN KEY (EXIT_REQUEST_ID)
        REFERENCES COOLING_OFF_REQUEST(EXIT_REQUEST_ID),

    CONSTRAINT FK_AUDIT_CLOSURE
        FOREIGN KEY (CLOSURE_REQUEST_ID)
        REFERENCES LOAN_CLOSURE_REQUEST(CLOSURE_REQUEST_ID),

    CONSTRAINT FK_AUDIT_NOC
        FOREIGN KEY (NOC_ID)
        REFERENCES NOC(NOC_ID),

    CONSTRAINT FK_AUDIT_GRIEVANCE
        FOREIGN KEY (GRIEVANCE_ID)
        REFERENCES GRIEVANCES(GRIEVANCE_ID),

    CONSTRAINT FK_AUDIT_RELEASE
        FOREIGN KEY (RELEASE_REQUEST_ID)
        REFERENCES COLLATERAL_RELEASE_REQUESTS(REQUEST_ID),

    CONSTRAINT CHK_AUDIT_ENTITY_TYPE CHECK (
        ENTITY_TYPE IN (
            'PAYMENT',
            'SETTLEMENT_QUOTE',
            'COOLING_OFF_REQUEST',
            'LOAN_CLOSURE_REQUEST',
            'NOC',
            'GRIEVANCE',
            'COLLATERAL_RELEASE_REQUEST',
            'OFFICER'
        )
    ),

    CONSTRAINT CHK_AUDIT_ENTITY_REF CHECK (
        (
            ENTITY_TYPE = 'PAYMENT'
            AND PAYMENT_ID IS NOT NULL
            AND PAYMENT_ID = ENTITY_ID
        )
        OR (
            ENTITY_TYPE = 'SETTLEMENT_QUOTE'
            AND QUOTE_ID IS NOT NULL
            AND QUOTE_ID = ENTITY_ID
        )
        OR (
            ENTITY_TYPE = 'COOLING_OFF_REQUEST'
            AND EXIT_REQUEST_ID IS NOT NULL
            AND EXIT_REQUEST_ID = ENTITY_ID
        )
        OR (
            ENTITY_TYPE = 'LOAN_CLOSURE_REQUEST'
            AND CLOSURE_REQUEST_ID IS NOT NULL
            AND CLOSURE_REQUEST_ID = ENTITY_ID
        )
        OR (
            ENTITY_TYPE = 'NOC'
            AND NOC_ID IS NOT NULL
            AND NOC_ID = ENTITY_ID
        )
        OR (
            ENTITY_TYPE = 'GRIEVANCE'
            AND GRIEVANCE_ID IS NOT NULL
            AND GRIEVANCE_ID = ENTITY_ID
        )
        OR (
            ENTITY_TYPE = 'COLLATERAL_RELEASE_REQUEST'
            AND RELEASE_REQUEST_ID IS NOT NULL
            AND RELEASE_REQUEST_ID = ENTITY_ID
        )
        OR (
            ENTITY_TYPE = 'OFFICER'
            AND OFFICER_ID IS NOT NULL
            AND OFFICER_ID = ENTITY_ID
        )
    )
);


-- ============================================================
-- INDEXES
-- ============================================================

CREATE INDEX IDX_OFFICER_ROLE
    ON OFFICER(ROLE);

CREATE INDEX IDX_OFFICER_STATUS
    ON OFFICER(ACCOUNT_STATUS);

CREATE INDEX IDX_LOAN_BORROWER
    ON LOAN_ACCOUNT(BORROWER_ID);

CREATE INDEX IDX_LOAN_RULE
    ON LOAN_ACCOUNT(RULE_ID);

CREATE INDEX IDX_COOLING_LOAN
    ON COOLING_OFF_REQUEST(LOAN_ID);

CREATE INDEX IDX_COOLING_OFFICER
    ON COOLING_OFF_REQUEST(OFFICER_ID);

CREATE INDEX IDX_COOLING_STATUS
    ON COOLING_OFF_REQUEST(STATUS);

CREATE INDEX IDX_CLOSURE_LOAN
    ON LOAN_CLOSURE_REQUEST(LOAN_ID);

CREATE INDEX IDX_CLOSURE_OFFICER
    ON LOAN_CLOSURE_REQUEST(OFFICER_ID);

CREATE INDEX IDX_CLOSURE_STATUS
    ON LOAN_CLOSURE_REQUEST(STATUS);

CREATE INDEX IDX_QUOTE_LOAN
    ON SETTLEMENT_QUOTE(LOAN_ID);

CREATE INDEX IDX_QUOTE_EXIT
    ON SETTLEMENT_QUOTE(EXIT_REQUEST_ID);

CREATE INDEX IDX_QUOTE_CLOSURE
    ON SETTLEMENT_QUOTE(CLOSURE_REQUEST_ID);

CREATE INDEX IDX_PAYMENT_QUOTE
    ON PAYMENT(QUOTE_ID);

CREATE INDEX IDX_PAYMENT_STATUS
    ON PAYMENT(PAYMENT_STATUS);

CREATE INDEX IDX_PAYMENT_DATE
    ON PAYMENT(PAYMENT_DATE);

CREATE INDEX IDX_NOC_LOAN
    ON NOC(LOAN_ID);

CREATE INDEX IDX_NOC_ISSUE_DATE
    ON NOC(ISSUE_DATE);

CREATE INDEX IDX_GRIEVANCES_LOAN
    ON GRIEVANCES(LOAN_ACCOUNT_ID);

CREATE INDEX IDX_GRIEVANCES_BORROWER
    ON GRIEVANCES(BORROWER_ID);

CREATE INDEX IDX_GRIEVANCES_OFFICER
    ON GRIEVANCES(ASSIGNED_TO);

CREATE INDEX IDX_GRIEVANCE_HISTORY_ID
    ON GRIEVANCES_HISTORY(GRIEVANCE_ID, ACTION_AT);

CREATE INDEX IDX_COLLATERAL_LOAN
    ON COLLATERAL(LOAN_ACCOUNT_ID);

CREATE INDEX IDX_RELEASE_LOAN
    ON COLLATERAL_RELEASE_REQUESTS(LOAN_ACCOUNT_ID);

CREATE INDEX IDX_RELEASE_STATUS
    ON COLLATERAL_RELEASE_REQUESTS(STATUS);

CREATE INDEX IDX_AUDIT_USER
    ON AUDIT_LOG(USER_ID);

CREATE INDEX IDX_AUDIT_OFFICER
    ON AUDIT_LOG(OFFICER_ID);

CREATE INDEX IDX_AUDIT_ENTITY
    ON AUDIT_LOG(ENTITY_TYPE, ENTITY_ID);

CREATE INDEX IDX_AUDIT_PAYMENT
    ON AUDIT_LOG(PAYMENT_ID);

CREATE INDEX IDX_AUDIT_QUOTE
    ON AUDIT_LOG(QUOTE_ID);

CREATE INDEX IDX_AUDIT_EXIT
    ON AUDIT_LOG(EXIT_REQUEST_ID);

CREATE INDEX IDX_AUDIT_CLOSURE
    ON AUDIT_LOG(CLOSURE_REQUEST_ID);

CREATE INDEX IDX_AUDIT_NOC
    ON AUDIT_LOG(NOC_ID);

CREATE INDEX IDX_AUDIT_GRIEVANCE
    ON AUDIT_LOG(GRIEVANCE_ID);

CREATE INDEX IDX_AUDIT_RELEASE
    ON AUDIT_LOG(RELEASE_REQUEST_ID);

CREATE INDEX IDX_AUDIT_ACTION_TIME
    ON AUDIT_LOG(ACTION_TIME);


