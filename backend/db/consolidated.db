/

DECLARE
    object_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO object_count FROM USER_INDEXES WHERE INDEX_NAME = 'IDX_AUDIT_ACTION_TIME';
    IF object_count = 0 THEN
        BEGIN
            EXECUTE IMMEDIATE q'~CREATE INDEX IDX_AUDIT_ACTION_TIME
    ON AUDIT_LOG(ACTION_TIME)~';
        EXCEPTION
            WHEN OTHERS THEN
                -- An equivalent index may already exist under a different name.
                IF SQLCODE != -1408 THEN RAISE; END IF;
        END;
    END IF;
END;
/


-- ============================================================
-- VERIFICATION
-- Count how many expected tables exist
-- ============================================================

-- Reruns preserve configured fees and saved settlement amounts.
-- Fresh rule inserts default to a 500 processing fee unless explicitly supplied.

SELECT TABLE_NAME, COLUMN_NAME, DATA_TYPE
FROM USER_TAB_COLUMNS
WHERE (TABLE_NAME = 'LOAN_PRODUCT_RULE' AND COLUMN_NAME = 'CLOSURE_TAX_RATE')
   OR (TABLE_NAME = 'LOAN_ACCOUNT' AND COLUMN_NAME IN (
       'INTEREST_PAID_THROUGH', 'INTEREST_RATE_TYPE', 'LOAN_PURPOSE', 'PREPAYMENT_CHARGE_ALLOWED'))
   OR (TABLE_NAME = 'SETTLEMENT_QUOTE' AND COLUMN_NAME IN (
       'CALCULATION_VERSION', 'INTEREST_PAID_THROUGH', 'INTEREST_AS_OF_DATE',
       'ACCRUED_INTEREST_DAYS', 'QUOTED_ANNUAL_RATE', 'APPLIED_CHARGE_TYPE',
       'APPLIED_CHARGE_VALUE', 'APPLIED_TAX_RATE', 'CHARGE_POLICY_REASON'))
ORDER BY TABLE_NAME, COLUMN_NAME;
-- Expected: 14 settlement columns across the three tables.

SELECT RULE_ID, PRODUCT_TYPE, COOLING_OFF_PROCESSING_FEE
FROM LOAN_PRODUCT_RULE
ORDER BY RULE_ID;

SELECT COUNT(*) AS TOTAL_TABLES
FROM USER_TABLES
WHERE TABLE_NAME IN (
    'BORROWERS',
    'OFFICER',
    'LOAN_PRODUCT_RULE',
    'LOAN_ACCOUNT',
    'COOLING_OFF_REQUEST',
    'LOAN_CLOSURE_REQUEST',
    'SETTLEMENT_QUOTE',
    'PAYMENT',
    'NOC',
    'NOC_AUDIT',
    'GRIEVANCES',
    'GRIEVANCES_HISTORY',
    'COLLATERAL',
    'COLLATERAL_RELEASE_REQUESTS',
    'AUDIT_LOG'
);

-- Expected result: 15

COMMIT;

WHENEVER SQLERROR CONTINUE NONE
