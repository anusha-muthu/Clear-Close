SELECT COUNT(*) AS TOTAL_TABLES
FROM USER_TABLES
WHERE TABLE_NAME IN (
    'BORROWERS',
    'OFFICER',
    'LOAN_PRODUCT_RULE',
    'LOAN_ACCOUNT',
    'COOLING_OFF_REQUEST',
    'LOAN_CLOSURE_REQUEST',
    'SETTLEMENT_QUOTE',
    'PAYMENT',
    'NOC',
    'GRIEVANCES',
    'GRIEVANCES_HISTORY',
    'COLLATERAL',
    'COLLATERAL_RELEASE_REQUESTS',
    'AUDIT_LOG'
);

-- Expected result: 14

