# Set these in your IDE run configuration or Java process environment.
# Spring Boot does not automatically read this file.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PAYMENT_EVENT_GROUP=clearclose-exit-payment-v1
PAYMENT_EVENT_LISTENER_ENABLED=true
KAFKA_EVENT_PARTITIONS=3
KAFKA_EVENT_REPLICAS=1

# Same random secret (at least 32 bytes) in Exit Service and LoanAccount only.
EXIT_LOAN_SERVICE_SECRET=REPLACE_WITH_A_RANDOM_SERVICE_SECRET
LOAN_ACCOUNT_SERVICE_URL=http://localhost:8085
FINAL_EXIT_RETRY_DELAY_MS=30000
FINAL_EXIT_RETRY_BATCH_SIZE=20
